{
    "name": "keyorix-web",
    "private": true,
    "type": "module",
    "version": "0.0.0",
    "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "lint": "eslint . --max-warnings 40",
        "lint:fix": "eslint . --fix",
        "type-check": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "analyze": "npx vite-bundle-analyzer",
        "generate:api-types": "openapi-typescript ../server/http/handlers/openapi.yaml -o src/types/api-generated.ts",
        "check:api-types-fresh": "node scripts/check-api-types-fresh.mjs",
        "check:api-contract": "node scripts/check-api-contract.mjs",
        "check:sharing-guide-strings": "node scripts/check-sharing-guide-ui-strings.mjs"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.9.1",
        "@tanstack/react-query": "^5.104.5",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "7.91.0",
        "react-router": "^8.5.0",
        "safe-regex": "2.1.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/jest-axe": "^3.5.9",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/safe-regex": "1.1.6",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^4.1.12",
        "@vitest/ui": "^4.1.12",
        "eslint": "^10.13.0",
        "eslint-plugin-no-unsanitized": "^4.1.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jest-axe": "^11.0.0",
        "js-yaml": "^5.5.0",
        "jsdom": "^30.1.3",
        "openapi-typescript": "^7.6.1",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vite-bundle-analyzer": "^1.3.9",
        "vitest": "^4.1.12",
        "yaml": "^2.9.1"
    }
}
