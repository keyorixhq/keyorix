# =============================================================================
# Keyorix Project - Comprehensive .gitignore
# =============================================================================

# --- Binary Executables ---
# Anchored to the repo root so they match the built binaries, not any nested
# directory named `keyorix` (e.g. deploy/helm/keyorix/).
/keyorix
/keyorix-server
server/keyorix-server
cmd/keyorix
cmd/keyorix-server
*.exe
*.exe~
*.dll
*.so
*.dylib

# --- Go Build Artifacts ---
/bin/
/build/
/dist/
*.test
*.out
*.prof
coverage.out
*.coverprofile
*.testresult

# --- Python Build/Test Artifacts (scripts/mutation-testing) ---
__pycache__/
*.pyc
.pytest_cache/
.coverage
coverage-python.xml

# --- Database Files ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
keyorix.db
test-keyorix.db
data/*.db

# SQLite cross-process migration lock sidecar (factory_sqlite_migration_lock.go)
# -- named "<configured database.path>.migration.lock", cwd-relative by
# default (#1636), so it appears wherever a CLI command or test happened to
# run from, not just next to a real database file.
*.migration.lock

# --- Log Files ---
*.log
*.log.*
logs/
server/logs/
telemetry/

# --- Configuration Files (keep templates) ---
keyorix.yaml
config.yaml
*.local.yaml
.env
.env.local
.env.*.local
.env.development
.env.production
test-config.yaml

# --- Security & Keys ---
keys/
certs/
*.key
*.crt
*.pem
*.p12
*.pfx

# --- Node.js / Web Build Artifacts ---
node_modules/
web/node_modules/
web/dist/
web/dist-ssr/
web/build/
web/.next/
web/.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- Test Artifacts ---
test-results/
playwright-report/
web/playwright-report/
web/test-results/
coverage/
.nyc_output/

# --- Docker & Container Artifacts ---
docker-compose.override.yml
.dockerignore.local

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Editor & IDE Files ---
.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# --- Temporary Files ---
*.tmp
*.temp
*.bak
*.backup
backup.yaml
/core

# --- Go Workspace Files ---
go.work
go.work.sum

# --- Dependency Vendoring ---
/vendor/

# --- CI/CD & Build Cache ---
.cache/
output/
artifacts/
.task/

# --- Development Tools ---
.keyorix_history
.keyorix_cache

# --- Security Reports ---
/security/
*.sarif

# --- Compressed Archives ---
*.zip
*.tar.gz
*.tgz

# --- Keep Important Files (Negative Patterns) ---
!.gitignore
!.gitkeep
!*.md
!*.yaml.tpl
!*.example
!Dockerfile
!Makefile

# --- Local Development ---
.kiro/
*.spec.json
# === AI / DevOps hygiene ===

# archives
*.zip
*.tar
*.gz
*.rar
*.7z

# binaries & databases
*.db
*.sqlite
*.sqlite3
*.log

# OS junk
.DS_Store

# temp / artifacts
tmp/
temp/
*.out
*.cache

# security / reports
*.sarif
*.report.json

# local MCP config (contains credentials)
.claude/mcp.json

data_key
certs/

# Embedded web UI: commit only the placeholder; release builds (`make build-ui`)
# copy the real keyorix-web bundle in, which must not be committed.
/server/webui/dist/*
!/server/webui/dist/index.html

# compiled binary debris (use bin/ via make build)
/main

# throwaway binaries / test artifacts -- unanchored (not /.scratch/ alone) so
# a nested module's own .scratch/ (e.g. operator/.scratch/) is covered too;
# found leaking into `git status` at the repo root during #1636's investigation.
.scratch/

# Claude Code internal state and local tooling
/.claire/
/tools

# devtools/*/'s own `go build ./...` output -- each is a main package that
# builds a same-named binary directly into its source directory by default.
/devtools/asymanalyzer/asymanalyzer
/devtools/familycheck/familycheck
