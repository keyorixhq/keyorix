#!/bin/sh
# Auto-append Signed-off-by to every commit so DCO check never fails.
# Enable with: git config core.hooksPath .githooks
#
# Skips merge/squash/revert/fixup commits and commits that already have a
# Signed-off-by trailer.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Don't add SOB to merge, squash, revert, or fixup commits.
case "$COMMIT_SOURCE" in
  merge|squash|commit) exit 0 ;;
esac

# Already signed — nothing to do.
if grep -qs "^Signed-off-by:" "$COMMIT_MSG_FILE"; then
  exit 0
fi

# Resolve the author identity (same way git does).
NAME=$(git config user.name)
EMAIL=$(git config user.email)

if [ -z "$NAME" ] || [ -z "$EMAIL" ]; then
  exit 0
fi

printf "\nSigned-off-by: %s <%s>\n" "$NAME" "$EMAIL" >> "$COMMIT_MSG_FILE"
