# Proposed CI workflow for the finding re-fuzz gate (AI-T3).
#
# This file is NOT under .github/ and does NOT enable any CI.
# It is a design document.  To activate, copy to
# .github/workflows/finding-regate.yml after the founder decides which
# variant (A or B) to deploy and sets up the required secrets.
#
# See docs/fuzzing/finding-regate.md for the full design and cost analysis.
# Recommendation: use Variant A (private registry, merge-queue only).

---
# =============================================================================
# Variant A — Private registry, merge-queue only (RECOMMENDED)
# =============================================================================
#
# Requires:
#   - FUZZ_CORPUS_DEPLOY_KEY: read-only deploy key for keyorixhq/fuzz-corpus
#     (a secret in the keyorix repo, not the fuzz-corpus repo)
#
# Cost: ~2–10 extra minutes per merge-queue entry (see docs for ceiling).
# Runs only in the GitHub merge queue, not on every push.
#
name: finding-regate

on:
  merge_group:
    types: [checks_requested]

jobs:
  finding-regate:
    name: "re-fuzz gate (merge queue)"
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout keyorix
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: false   # We mount our own GOCACHE below

      - name: Clone fuzz-corpus (private, deploy key)
        uses: actions/checkout@v4
        with:
          repository: keyorixhq/fuzz-corpus
          ssh-key: ${{ secrets.FUZZ_CORPUS_DEPLOY_KEY }}
          path: .fuzz-corpus
          depth: 1

      # Optional: pre-build the fuzz targets to warm the cache and catch
      # compilation errors before spending burst time.
      - name: Pre-build fuzz targets
        run: |
          # Build only the packages that have fuzz targets in this diff
          python3 scripts/fuzzing/finding-regate/regate.py \
            --diff-range "${{ github.event.merge_group.base_sha }}..${{ github.event.merge_group.head_sha }}" \
            --registry .fuzz-corpus/registry/findings \
            --targets-d scripts/fuzzing/targets.d \
            --no-burst --no-replay --dry-run
        env:
          GOCACHE: /home/runner/.cache/go-build
          GOMODCACHE: /home/runner/go/pkg/mod

      - name: Run finding re-fuzz gate
        run: |
          python3 scripts/fuzzing/finding-regate/regate.py \
            --diff-range "${{ github.event.merge_group.base_sha }}..${{ github.event.merge_group.head_sha }}" \
            --registry .fuzz-corpus/registry/findings \
            --targets-d scripts/fuzzing/targets.d \
            --fuzztime "${FUZZTIME:-60s}" \
            --verbose
        env:
          GOCACHE: /home/runner/.cache/go-build
          GOMODCACHE: /home/runner/go/pkg/mod
          GOMAXPROCS: "2"
          FUZZTIME: "60s"
          # To use the private reproducer bytes from the corpus, generate a
          # registered-seeds JSON from the corpus and pass it here:
          # REGISTERED_SEEDS: .fuzz-corpus/registered-seeds.json
          #
          # The registered-seeds.json is generated by:
          #   python3 scripts/fuzzing/finding-regate/gen-registered-seeds.py \
          #     --corpus .fuzz-corpus \
          #     --repo-root . \
          #     > .fuzz-corpus/registered-seeds.json
          # (gen-registered-seeds.py: future work, see docs)

      # Always upload the .scratch/ gate log for post-mortem
      - name: Upload gate artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: regate-output-${{ github.run_id }}
          path: .scratch/regate-*.txt
          retention-days: 7

---
# =============================================================================
# Variant B — Public-safe registry export, every PR push (alternative)
# =============================================================================
#
# Requires:
#   - scripts/fuzzing/finding-regate/public-safe-registry.json committed to
#     the repo (generated by the founder from the private corpus; contains
#     IDs, package paths, func names, and committed seed file names — NO bytes)
#
# No secrets required.  Runs on every pull_request push.
# Cost: ~1–5 extra minutes per PR push (30 s burst, fewer matched findings).
#
# Activation: uncomment and copy to .github/workflows/finding-regate-public.yml

