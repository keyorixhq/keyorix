{
  "case": "testbed-glob-plus-deny",
  "description": "Testbed policies mig1-glob-readonly + mig1-deny-prod attached to one role (seed.sh attaches them separately; this binding is the deny-overlap scenario).",
  "constructed": false,
  "sources": [
    "scripts/vault-migration-testbed/seed.sh#mig1-glob-readonly",
    "scripts/vault-migration-testbed/seed.sh#mig1-deny-prod"
  ],
  "kv_mounts": [
    {
      "path": "secret/",
      "kv_version": 2
    },
    {
      "path": "team-b/",
      "kv_version": 2
    },
    {
      "path": "kv1-legacy/",
      "kv_version": 1
    }
  ],
  "vault_rules": [
    {
      "policy": "mig1-glob-readonly",
      "path": "secret/data/*",
      "capabilities": [
        "read",
        "list"
      ]
    },
    {
      "policy": "mig1-deny-prod",
      "path": "secret/data/org/team-a/*",
      "capabilities": [
        "deny"
      ]
    }
  ],
  "imports": [
    {
      "mount": "secret/",
      "path_prefix": "",
      "project_id": 1,
      "environment_id": 11
    }
  ],
  "grants": [],
  "unmappable": [
    {
      "source_ref": "policy:mig1-glob-readonly path:secret/data/*",
      "category": "deny-overlap"
    }
  ]
}
