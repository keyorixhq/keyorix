{
  "case": "demo-finance-batch-job",
  "description": "Migration demo AppRole finance-batch-job (payments-readonly + payments-deny-db).",
  "constructed": false,
  "sources": [
    "scripts/demo/vault-migration-demo.sh#payments-readonly",
    "scripts/demo/vault-migration-demo.sh#payments-deny-db"
  ],
  "kv_mounts": [
    {
      "path": "secret/",
      "kv_version": 2
    },
    {
      "path": "kv1-legacy/",
      "kv_version": 1
    }
  ],
  "vault_rules": [
    {
      "policy": "payments-readonly",
      "path": "secret/data/payments/*",
      "capabilities": [
        "read",
        "list"
      ]
    },
    {
      "policy": "payments-deny-db",
      "path": "secret/data/payments/*",
      "capabilities": [
        "read",
        "list"
      ]
    },
    {
      "policy": "payments-deny-db",
      "path": "secret/data/payments/db",
      "capabilities": [
        "deny"
      ]
    }
  ],
  "imports": [
    {
      "mount": "secret/",
      "path_prefix": "",
      "project_id": 1,
      "environment_id": 11
    }
  ],
  "grants": [],
  "unmappable": [
    {
      "source_ref": "policy:payments-readonly path:secret/data/payments/*",
      "category": "deny-overlap"
    },
    {
      "source_ref": "policy:payments-deny-db path:secret/data/payments/*",
      "category": "deny-overlap"
    }
  ]
}
