# oracle-health-nightly.env.example -- EnvironmentFile for oracle-health-nightly.service.
#
# Install as /etc/oracle-health-nightly/env, mode 0600, owner root (systemd reads
# it as root before dropping to User=). NEVER commit a filled-in copy: the DSN
# below carries a superuser password. Lines are KEY=VALUE, no `export`, no quotes
# needed, no shell expansion.
# Everything except the DSN has a working default in oracle-health-nightly.sh.

# --- Postgres (REQUIRED for the heavy entries) --------------------------------
# A SUPERUSER role on the pve01 Postgres 17 (canary-echo-pg and authzdiff-plants
# create and drop databases/extensions; the other pg entries need a database).
# Without it the pg entries SKIP, --strict turns that into exit 3, and the run
# alerts "SKIP" for every one of them.
KEYORIX_TEST_PG_DSN=postgres://CHANGE-ME:CHANGE-ME@127.0.0.1:5432/postgres?sslmode=disable

# --- paths --------------------------------------------------------------------
# The dedicated clone (never a working checkout: it is fast-forwarded, and a
# dirty tree is refused). Must be a clone of keyorixhq/keyorix on branch main.
OHN_CLONE=/opt/oracle-health-nightly/keyorix
# Skip counter and per-day alert markers.
OHN_STATE_DIR=/var/lib/oracle-health-nightly
# Dated full logs and one-line-per-entry summaries (kept OHN_LOG_KEEP_DAYS days).
OHN_LOG_DIR=/var/lib/oracle-health-nightly/logs
OHN_LOG_KEEP_DAYS=30
# Scratch trees (throwaway worktrees, go test temp files). Must be tmpfs.
OHN_TMPFS=/dev/shm
# Prepended to PATH when it exists (pg_ctl, initdb, psql for the pg entries).
OHN_PG_BIN=/usr/lib/postgresql/17/bin

# systemd's default PATH has no Go. Set it if go lives elsewhere (the Go version
# the repo's go.mod needs must be first).
#PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# --- budget -------------------------------------------------------------------
# Hard limit for oracle-health.sh. Keep it below the unit's TimeoutStartSec.
OHN_TIMEOUT_SECS=10800

# --- host gate (refuse to start; no alert, counts toward the stale alert) ------
# Space-separated lock file(s). The service user must be able to search the
# directory (a lock under /root needs root, or a readable copy); if it cannot,
# the gate refuses rather than assume "no lock".
OHN_HOST_LOCK=/root/PVE-BENCH-LOCK
OHN_MAX_TEMP_C=86
OHN_MAX_LOAD5=6
OHN_MIN_MEM_AVAIL_GB=12
# Every entry keeps a throwaway tree until the run ends (about 22 trees of a few
# hundred MB: an estimate, not measured on pve01), so the floor is generous.
OHN_MIN_SHM_FREE_MB=8192
# Temperature source for the built-in gate: a command printing the average CPU
# temperature in degrees C. Default: mean of /sys/class/thermal/thermal_zone*/temp.
#OHN_TEMP_CMD=/usr/local/bin/pve01-temp-avg
# Or replace the whole built-in gate with the host's own (exit 0 = go, anything
# else = refuse, first output line = reason). Check its exit semantics first.
#OHN_GATE_CMD=/mnt/data/wave8/gate.sh
# Alert after this many consecutive skipped nights.
OHN_SKIP_ALERT_AFTER=3

# --- alerting -----------------------------------------------------------------
# The topic is a name, not a secret. Set OHN_NTFY_TOKEN only if the server needs
# auth (characters A-Za-z0-9_.- only); it is sent via `curl -K -`, never argv.
OHN_NTFY_URL=https://ntfy.sh/andrey_fuzz_allert
#OHN_NTFY_TOKEN=
