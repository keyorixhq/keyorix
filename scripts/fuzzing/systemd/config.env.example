# config.env.example — EnvironmentFile for keyorix-xreplica-fuzz.service.
#
# Install as /etc/keyorix-xreplica/config.env, mode 0600, owned by root.
# Every value here has a working default in nightly-cross-replica.sh; the only
# one you MUST set for the rig to be useful is NTFY_TOPIC, because without it
# a finding is written to a log and nobody is told.
#
# NEVER commit a filled-in copy of this file. NTFY_TOPIC doubles as the ntfy
# auth secret (that is why the script passes it via `curl -K` rather than on
# the command line — see scripts/dast/lib-alert.sh for the same pattern).

# --- paths -------------------------------------------------------------------
# The rig's own checkout. Reset to origin/main before every run, so do not
# keep local work here.
KEYORIX_REPO=/opt/keyorix-xreplica/keyorix
# Run logs and alert-dedup markers.
STATE_DIR=/opt/keyorix-xreplica/state
# The PRIVATE corpus checkout crashers are pushed to. Must be a clone of
# keyorixhq/fuzz-corpus (private) with a working push credential — never a
# public repo: an unfixed own-code race must not be disclosed before its fix.
CORPUS_REPO=/opt/keyorix-xreplica/fuzz-corpus
CORPUS_SUBDIR=corpus/internal-core/FuzzCrossReplicaInvariants

# --- run budget --------------------------------------------------------------
# See nightly-cross-replica.sh's own comment on why this is 3h45m and not the
# brief's literal 4h: the window is four hours wide and the run also pays for
# container start, migration, the ordering sweep and the corpus push.
FUZZTIME=3h45m

# --- host coexistence --------------------------------------------------------
# The benchmark sessions' host lock. The script SKIPS (exit 0, no alert) when
# this exists at startup, and ABORTS cleanly if it appears mid-run. Set to
# empty on a box that runs no benchmarks.
HOST_LOCK=/root/PVE-BENCH-LOCK
LOCK_POLL_SECONDS=60

# --- Postgres ----------------------------------------------------------------
# A dedicated throwaway container, removed on every exit path. Do not point
# this at a shared server: the fuzzer isolates by schema, but a shared
# server's other work still contends for connection slots and the lock table,
# which is precisely what a cross-replica race test mis-measures under.
PG_CONTAINER=keyorix-xreplica-pg
PG_IMAGE=postgres:16
PG_PASSWORD=change-me-any-local-only-value

# --- alerting ----------------------------------------------------------------
# Full ntfy topic URL, e.g. https://ntfy.sh/kx-xreplica-<random>.
# Unset = silent no-op, same as scripts/dast/lib-alert.sh.
NTFY_TOPIC=
