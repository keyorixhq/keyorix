// Package lib is a stand-in "third-party" dependency for reachgen's unit test.
package lib

// ParseRequest is an exported parser taking a string (the fuzzable, untrusted shape).
func ParseRequest(s string) error { return nil }

// ParseBytes takes a []byte.
func ParseBytes(b []byte) error { return nil }

// FromConfig takes a value; the fixture calls it with a config-typed argument.
func FromConfig(s string) {}

// StaticOnly is only ever called with a compile-time literal in the fixture.
func StaticOnly(s string) {}

// Decoder exercises method-call resolution.
type Decoder struct{}

// NewDecoder returns a Decoder.
func NewDecoder() *Decoder { return &Decoder{} }

// Decode is a method taking a []byte.
func (d *Decoder) Decode(b []byte) error { return nil }

// unexportedHelper must never be recorded (not exported).
func unexportedHelper(s string) {} //nolint:unused
