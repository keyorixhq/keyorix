# scripts/ci/tool-versions.env -- the single source of truth for the CI tool
# versions pinned in .github/workflows (TOOLCHAIN-UNIFY-1).
#
# The workflows still carry their own pins (the *_VERSION env entries, the
# inline govulncheck install, the semgrep container image); this file does not
# feed them yet. scripts/ci/check-tool-versions.sh fails when a workflow pins
# one of these tools at a different version, or when a tool listed here is no
# longer pinned anywhere. To bump a tool, change this file AND the workflow pin
# in the same PR.
#
# Format: KEY=value, one per line, no quotes, no spaces; '#' starts a comment
# line. Every key must be one the checker knows how to find (it fails on an
# unknown key rather than skip it).
GOLANGCI_LINT_VERSION=v2.14.0
GOSEC_VERSION=v2.29.0
GITLEAKS_VERSION=8.30.1
TRIVY_VERSION=0.72.0
NUCLEI_VERSION=3.3.9
ACTIONLINT_VERSION=1.7.12
CHECKOV_VERSION=3.3.6
KUBECONFORM_VERSION=0.8.0
KUBE_SCORE_VERSION=1.20.0
GO_LICENSES_VERSION=v1.6.0
GOVULNCHECK_VERSION=v1.8.0
SEMGREP_VERSION=1.172.0
SEMGREP_IMAGE_DIGEST=sha256:65dcd4408adda7c183a6b4550cb1e9b19f7f627a6fbb7e0559bd466bedc44d7b
