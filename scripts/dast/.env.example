# Copy to /opt/keyorix-dast/.env on the DAST box (CT 221) and fill in real
# values there. Never commit .env -- this file lists variable NAMES only.
#
# KEYORIX_ADMIN_PASSWORD and any other Keyorix account password on this list
# must satisfy Keyorix's own password policy (checked in
# internal/core -- read it from source, don't guess a generator scheme).
# A password that is valid shell/URL-safe text but fails that policy makes
# /system/init silently reject bootstrap -- see refresh-src.sh /
# check-heartbeat.sh's post-bootstrap assertion, added after this failed
# silently for 10+ days on this box (empty `users` table, admin login
# permanently 401, nobody noticed).

# GitHub token used ONLY by create-issues.sh (gh issue list/create, gh label
# create) against keyorixhq/keyorix. Fine-grained PAT, repo-scoped to
# keyorixhq/keyorix only, Issues: Read and write + the mandatory Metadata:
# Read, 90-day expiry.
GH_TOKEN=

# PostgreSQL password for the DAST target stack's own database.
KEYORIX_DB_PASSWORD=

# Stable 32-byte hex KEK for this DAST box's target stack -- generate once,
# keep forever. Losing it makes the postgres data volume's encrypted secrets
# permanently undecryptable (acceptable to lose on this disposable box, but
# rotating it requires wiping and re-initializing the volume, not just
# changing this value).
KEYORIX_DAST_KEK=

# First-boot admin bootstrap for the DAST target stack (POST /system/init --
# an explicit API call, not automatic from these env vars alone; see
# refresh-src.sh's post-bootstrap assertion). Idempotent once already
# initialized.
KEYORIX_ADMIN_USERNAME=dast-admin
KEYORIX_ADMIN_EMAIL=dast@keyorix.local
KEYORIX_ADMIN_PASSWORD=
KEYORIX_BOOTSTRAP_TOKEN=

# Persistent lowest-privilege ("viewer" role) account for scan-zap-auth.sh's
# regular-user authenticated pass. Provisioned once by provision-testuser.sh,
# which appends these three lines to .env itself -- not meant to be
# hand-filled before first run.
KEYORIX_TESTUSER_USERNAME=
KEYORIX_TESTUSER_EMAIL=
KEYORIX_TESTUSER_PASSWORD=

# Optional. ntfy.sh topic (the full URL, e.g. https://ntfy.sh/keyorix-dast-<random>)
# that lib-alert.sh pushes every DAST-ALERT to. Unset = alerts still print to
# cron.log, just no push notification. Treat the URL itself as a secret --
# anyone who has it can publish to the topic.
NTFY_TOPIC=
