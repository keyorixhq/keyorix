# Copy to .env.development or .env.production and fill in values
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000
VITE_ENVIRONMENT=development
VITE_ENABLE_DEBUG=true
VITE_ENABLE_DEVTOOLS=true

# docker-compose.yml self-host deploy vars (read from a root .env by Docker
# Compose itself, not by Vite). No default is committed for the passwords —
# set real values before running `docker compose up`.
DB_USER=keyorix
DB_PASSWORD=
DB_NAME=keyorix
POSTGRES_PASSWORD=
