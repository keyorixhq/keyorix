# Keyorix self-hosted stack — copy to .env and fill in. NEVER commit .env.
#
# Generate strong values, e.g.:
#   openssl rand -base64 32

# PostgreSQL password (used by both the postgres and backend services). REQUIRED.
KEYORIX_DB_PASSWORD=

# Master passphrase the encryption KEK is derived from. REQUIRED.
# ⚠️  Back this up securely and NEVER change it after first boot — changing it (or
# losing the `keyorix_keys` volume) makes every stored secret undecryptable.
KEYORIX_MASTER_PASSWORD=

# First-boot admin bootstrap (optional). If KEYORIX_ADMIN_PASSWORD is set, the
# server creates this admin on first start (idempotent). Leave blank to initialise
# manually with `keyorix system init`.
KEYORIX_ADMIN_USERNAME=admin
KEYORIX_ADMIN_EMAIL=admin@keyorix.local
KEYORIX_ADMIN_PASSWORD=

# TLS (only used by the `tls` compose profile: docker compose --profile tls up).
# Set to your real domain (with ports 80/443 reachable + DNS pointing here) for an
# automatic, publicly-trusted certificate. Leave as localhost for Caddy's internal
# CA (browser trust warning).
KEYORIX_DOMAIN=localhost
